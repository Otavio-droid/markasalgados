import json
import os
from datetime import datetime
from difflib import SequenceMatcher
import re


class ChatbotTI:
    def __init__(self, arquivo_conhecimento="conhecimento_ti.json"):
        self.arquivo_conhecimento = arquivo_conhecimento
        self.conhecimento = self.carregar_conhecimento()

    def carregar_conhecimento(self):
        """Carrega a base de conhecimento do arquivo JSON"""
        if os.path.exists(self.arquivo_conhecimento):
            with open(self.arquivo_conhecimento, 'r', encoding='utf-8') as f:
                return json.load(f)
        return {
            "perguntas_respostas": [],
            "estatisticas": {
                "total_perguntas": 0,
                "perguntas_respondidas": 0,
                "ultima_atualizacao": None
            }
        }

    def salvar_conhecimento(self):
        """Salva a base de conhecimento no arquivo JSON"""
        with open(self.arquivo_conhecimento, 'w', encoding='utf-8') as f:
            json.dump(self.conhecimento, f, ensure_ascii=False, indent=2)

    def normalizar_texto(self, texto):
        """Normaliza o texto removendo pontuação e convertendo para minúsculas"""
        texto = texto.lower()
        texto = re.sub(r'[^\w\s]', '', texto)
        return texto.strip()

    def calcular_similaridade(self, texto1, texto2):
        """Calcula a similaridade entre dois textos"""
        texto1_norm = self.normalizar_texto(texto1)
        texto2_norm = self.normalizar_texto(texto2)
        return SequenceMatcher(None, texto1_norm, texto2_norm).ratio()

    def adicionar_pergunta_resposta(self, pergunta, resposta, analista):
        """Adiciona uma nova pergunta e resposta à base de conhecimento"""
        nova_entrada = {
            "id": len(self.conhecimento["perguntas_respostas"]) + 1,
            "pergunta": pergunta,
            "resposta": resposta,
            "analista": analista,
            "data_adicao": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "vezes_utilizada": 0,
            "feedback_positivo": 0,
            "feedback_negativo": 0
        }

        self.conhecimento["perguntas_respostas"].append(nova_entrada)
        self.conhecimento["estatisticas"]["ultima_atualizacao"] = datetime.now(
        ).strftime("%Y-%m-%d %H:%M:%S")
        self.salvar_conhecimento()

        return f"✓ Pergunta adicionada com sucesso! ID: {nova_entrada['id']}"

    def buscar_resposta(self, pergunta_usuario, limite_similaridade=0.6):
        """Busca a melhor resposta para a pergunta do usuário"""
        melhor_match = None
        melhor_similaridade = 0

        for item in self.conhecimento["perguntas_respostas"]:
            similaridade = self.calcular_similaridade(
                pergunta_usuario, item["pergunta"])

            if similaridade > melhor_similaridade and similaridade >= limite_similaridade:
                melhor_similaridade = similaridade
                melhor_match = item

        if melhor_match:
            # Atualiza estatísticas
            melhor_match["vezes_utilizada"] += 1
            self.conhecimento["estatisticas"]["perguntas_respondidas"] += 1
            self.salvar_conhecimento()

            return {
                "resposta": melhor_match["resposta"],
                "similaridade": melhor_similaridade,
                "id": melhor_match["id"],
                "analista": melhor_match["analista"]
            }

        return None

    def registrar_feedback(self, id_resposta, positivo=True):
        """Registra feedback do usuário sobre uma resposta"""
        for item in self.conhecimento["perguntas_respostas"]:
            if item["id"] == id_resposta:
                if positivo:
                    item["feedback_positivo"] += 1
                else:
                    item["feedback_negativo"] += 1
                self.salvar_conhecimento()
                return True
        return False

    def listar_conhecimento(self):
        """Lista toda a base de conhecimento"""
        return self.conhecimento["perguntas_respostas"]

    def obter_estatisticas(self):
        """Retorna estatísticas do chatbot"""
        total_feedbacks = sum(
            item["feedback_positivo"] + item["feedback_negativo"]
            for item in self.conhecimento["perguntas_respostas"]
        )

        feedbacks_positivos = sum(
            item["feedback_positivo"]
            for item in self.conhecimento["perguntas_respostas"]
        )

        taxa_satisfacao = (feedbacks_positivos /
                           total_feedbacks * 100) if total_feedbacks > 0 else 0

        return {
            "total_perguntas_base": len(self.conhecimento["perguntas_respostas"]),
            "perguntas_respondidas": self.conhecimento["estatisticas"]["perguntas_respondidas"],
            "taxa_satisfacao": f"{taxa_satisfacao:.1f}%",
            "total_feedbacks": total_feedbacks,
            "ultima_atualizacao": self.conhecimento["estatisticas"]["ultima_atualizacao"]
        }


def interface_analista(bot):
    """Interface para o analista de TI adicionar conhecimento"""
    print("\n" + "="*60)
    print("PAINEL DO ANALISTA DE TI")
    print("="*60)

    while True:
        print("\n1. Adicionar nova pergunta/resposta")
        print("2. Listar base de conhecimento")
        print("3. Ver estatísticas")
        print("4. Voltar ao menu principal")

        opcao = input("\nEscolha uma opção: ").strip()

        if opcao == "1":
            print("\n--- ADICIONAR NOVO CONHECIMENTO ---")
            pergunta = input("Digite a pergunta: ").strip()
            resposta = input("Digite a resposta: ").strip()
            analista = input("Nome do analista: ").strip()

            if pergunta and resposta and analista:
                resultado = bot.adicionar_pergunta_resposta(
                    pergunta, resposta, analista)
                print(f"\n{resultado}")
            else:
                print("\n✗ Todos os campos são obrigatórios!")

        elif opcao == "2":
            conhecimento = bot.listar_conhecimento()
            print("\n--- BASE DE CONHECIMENTO ---")
            if conhecimento:
                for item in conhecimento:
                    print(f"\nID: {item['id']}")
                    print(f"Pergunta: {item['pergunta']}")
                    print(f"Resposta: {item['resposta'][:100]}...")
                    print(f"Analista: {item['analista']}")
                    print(f"Usada: {item['vezes_utilizada']} vezes")
                    print(
                        f"Feedback: 👍 {item['feedback_positivo']} | 👎 {item['feedback_negativo']}")
            else:
                print("Nenhum conhecimento cadastrado ainda.")

        elif opcao == "3":
            stats = bot.obter_estatisticas()
            print("\n--- ESTATÍSTICAS ---")
            print(
                f"Total de perguntas na base: {stats['total_perguntas_base']}")
            print(f"Perguntas respondidas: {stats['perguntas_respondidas']}")
            print(f"Taxa de satisfação: {stats['taxa_satisfacao']}")
            print(f"Total de feedbacks: {stats['total_feedbacks']}")
            print(f"Última atualização: {stats['ultima_atualizacao']}")

        elif opcao == "4":
            break


def interface_usuario(bot):
    """Interface de chat para usuários tirarem dúvidas"""
    print("\n" + "="*60)
    print("CHATBOT DE SUPORTE TI")
    print("="*60)
    print("Digite suas dúvidas ou 'sair' para voltar ao menu")

    while True:
        pergunta = input("\n🙋 Você: ").strip()

        if pergunta.lower() in ['sair', 'exit', 'quit']:
            break

        if not pergunta:
            continue

        resultado = bot.buscar_resposta(pergunta)

        if resultado:
            print(f"\n🤖 Chatbot: {resultado['resposta']}")
            print(
                f"\n(Confiança: {resultado['similaridade']*100:.1f}% | Analista: {resultado['analista']})")

            feedback = input(
                "\nEsta resposta foi útil? (s/n): ").strip().lower()
            if feedback == 's':
                bot.registrar_feedback(resultado['id'], positivo=True)
                print("✓ Obrigado pelo feedback!")
            elif feedback == 'n':
                bot.registrar_feedback(resultado['id'], positivo=False)
                print("✓ Feedback registrado. Iremos melhorar!")
        else:
            print("\n🤖 Chatbot: Desculpe, não encontrei uma resposta para sua dúvida.")
            print("Por favor, entre em contato com o suporte técnico.")


def main():
    """Função principal do sistema"""
    bot = ChatbotTI()

    while True:
        print("\n" + "="*60)
        print("SISTEMA DE CHATBOT TI")
        print("="*60)
        print("\n1. Acesso Analista (Alimentar IA)")
        print("2. Acesso Usuário (Chat)")
        print("3. Sair")

        opcao = input("\nEscolha uma opção: ").strip()

        if opcao == "1":
            interface_analista(bot)
        elif opcao == "2":
            interface_usuario(bot)
        elif opcao == "3":
            print("\nEncerrando sistema...")
            break
        else:
            print("\nOpção inválida!")


if __name__ == "__main__":
    main()
